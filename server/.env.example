VOIDPAY_PUBLIC_KEY=
VOIDPAY_SECRET_KEY=
VOIDPAY_API_URL=https://dash.voidpayments.com/api/v1
PORT=3000

UTMIFY_API_TOKEN=configure_sua_credencial
SITE_URL=https://campanhasolidaria.fun
DATA_DIR=./data

# Vercel: conectar Upstash Redis (token de leitura E escrita)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Segredo aleatório para autenticar cron; mínimo recomendado: 32 caracteres
CRON_SECRET=

# Documento fixo autorizado para o gateway; manter apenas no servidor
PIX_DEFAULT_DOCUMENT=

# URL fixa já cadastrada no gateway; reutilizada em todas as cobranças
VOIDPAY_CALLBACK_URL=
